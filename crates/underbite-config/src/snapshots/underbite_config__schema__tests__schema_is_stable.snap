      "default": {
        "factors": {
          "low_light": 1.0,
          "pressure_falling": 0.7,
          "solunar": 0.5,
          "tide_stage": 1.0,
          "water_temp": 1.0
        },
        "show_solunar": true,
        "solunar_major_minutes": 120,
        "solunar_minor_minutes": 60
      }
    }
  },
  "title": "Underbite configuration",
  "type": "object"
}

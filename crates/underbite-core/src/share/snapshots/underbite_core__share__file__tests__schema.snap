---
source: crates/underbite-core/src/share/file.rs
expression: schemas
---
{
  "File": {
    "$defs": {
      "ChecklistItem": {
        "description": "One line of a trip's checklist.",
        "properties": {
          "done": {
            "default": false,
            "type": "boolean"
          },
          "id": {
            "description": "The host's id, stable across edits so merges can match items.",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "FlowPreference": {
        "description": "Which tide or current a species is said to feed on.",
        "oneOf": [
          {
            "enum": [
              "incoming",
              "outgoing",
              "slack_high",
              "slack_low",
              "slack"
            ],
            "type": "string"
          },
          {
            "const": "moving",
            "description": "Any moving water, as against slack.",
            "type": "string"
          }
        ]
      },
      "Fuzz": {
        "description": "How much of a place's location a shared file reveals. Ordered from most to least.\n\nThe level a place carries is the level it was fuzzed to, so the receiver can say \"approximate\nlocation\".",
        "oneOf": [
          {
            "const": "exact",
            "description": "The coordinates as saved.",
            "type": "string"
          },
          {
            "const": "rounded_1km",
            "description": "Rounded to 0.01 degrees, about a kilometre. Written `rounded_1km`; the earlier spelling\n`rounded1_km` is still read.",
            "type": "string"
          },
          {
            "const": "area_only",
            "description": "No coordinates; the area and region only.",
            "type": "string"
          }
        ]
      },
      "Kind": {
        "enum": [
          "trip",
          "spot",
          "layers",
          "profile"
        ],
        "type": "string"
      },
      "LayerId": {
        "description": "The stable id of a map layer, such as `sst` or `radar`.\n\nA string newtype rather than an enum, like [`SourceId`](crate::provenance::SourceId): a layer\nadded later needs no contract change, and an id this version does not know survives decoding so\nthat migration can drop it with a note.",
        "type": "string"
      },
      "LayersShare": {
        "description": "The `kind: \"layers\"` payload: a map layer preset, its name and its layers in drawing order,\nfirst at the bottom.",
        "properties": {
          "layers": {
            "default": [],
            "items": {
              "$ref": "#/$defs/SharedLayer"
            },
            "type": "array"
          },
          "name": {
            "description": "The preset's name as the sender sees it.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Licence": {
        "description": "Under which terms a value may be used and shown.",
        "oneOf": [
          {
            "const": "public_domain",
            "description": "Work of a government agency, free of copyright.",
            "type": "string"
          },
          {
            "const": "cc_by4",
            "description": "Creative Commons Attribution 4.0.",
            "type": "string"
          },
          {
            "const": "cc_by_nc4",
            "description": "Creative Commons Attribution-NonCommercial 4.0 (`FishBase`).",
            "type": "string"
          },
          {
            "const": "published",
            "description": "A published paper or page whose own terms apply; the value is a cited fact.",
            "type": "string"
          },
          {
            "const": "user_edited",
            "description": "Typed in by the user.",
            "type": "string"
          }
        ]
      },
      "LightPreference": {
        "description": "The light a species is said to feed in.",
        "enum": [
          "dawn",
          "day",
          "dusk",
          "night",
          "overcast"
        ],
        "type": "string"
      },
      "Method": {
        "description": "How a person fishes; the limits and the gear list follow it.",
        "enum": [
          "boat",
          "kayak",
          "shore",
          "wade",
          "ice"
        ],
        "type": "string"
      },
      "ProfileShare": {
        "description": "The `kind: \"profile\"` payload: one species profile as its sender has it.",
        "properties": {
          "edits": {
            "$ref": "#/$defs/SpeciesEdit",
            "description": "The sender's own values, laid over `species` when shown; absent when there are none."
          },
          "species": {
            "$ref": "#/$defs/SpeciesProfile",
            "description": "The profile as the sender's catalogue holds it: every value with its source and licence,\nand no edits."
          }
        },
        "required": [
          "species"
        ],
        "type": "object"
      },
      "Range": {
        "additionalProperties": false,
        "description": "A closed range of a quantity, low to high, in canonical units.",
        "properties": {
          "high": {
            "format": "float",
            "type": "number"
          },
          "low": {
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "low",
          "high"
        ],
        "type": "object"
      },
      "SharedLayer": {
        "description": "One layer of a shared map preset: its state as the map settings keep it in a preset.",
        "properties": {
          "id": {
            "$ref": "#/$defs/LayerId"
          },
          "opacity": {
            "description": "0 (clear) to 1 (solid); none means the layer's own.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "ramp": {
            "description": "The colour ramp by id; none means the layer's own.",
            "type": [
              "string",
              "null"
            ]
          },
          "range": {
            "description": "The value range the ramp spans, low and high, in canonical units; none means the layer's\nown.",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "format": "float",
                "type": "number"
              },
              {
                "format": "float",
                "type": "number"
              }
            ],
            "type": [
              "array",
              "null"
            ]
          },
          "shown": {
            "default": false,
            "description": "Whether the preset shows the layer.",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "SourceRef": {
        "additionalProperties": false,
        "description": "Where a value came from.",
        "properties": {
          "citation": {
            "description": "The citation of the database or work as a whole.",
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "$ref": "#/$defs/Licence"
          },
          "name": {
            "description": "Who says so, for example \"`FishBase`\" or \"NOAA Fisheries\".",
            "type": "string"
          },
          "reference": {
            "description": "The record's own reference (author and year), which `FishBase` asks to be cited.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "A link back to the page or record. Required for CC BY-NC values (the licence asks for it).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "licence"
        ],
        "type": "object"
      },
      "Sourced": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced2": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced3": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "$ref": "#/$defs/WaterKind"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced4": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "$ref": "#/$defs/Range"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced5": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "additionalProperties": false,
            "properties": {
              "autumn": {
                "$ref": "#/$defs/Range"
              },
              "spring": {
                "$ref": "#/$defs/Range"
              },
              "summer": {
                "$ref": "#/$defs/Range"
              },
              "winter": {
                "$ref": "#/$defs/Range"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced6": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "items": {
              "$ref": "#/$defs/FlowPreference"
            },
            "type": "array"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "Sourced7": {
        "additionalProperties": false,
        "description": "A value and its source.",
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceRef"
          },
          "value": {
            "items": {
              "$ref": "#/$defs/LightPreference"
            },
            "type": "array"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "type": "object"
      },
      "SpeciesEdit": {
        "additionalProperties": false,
        "description": "The user's overrides for one species. A field that is `None` is not overridden.",
        "properties": {
          "common_names": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "depth_m": {
            "additionalProperties": false,
            "properties": {
              "autumn": {
                "$ref": "#/$defs/Range"
              },
              "spring": {
                "$ref": "#/$defs/Range"
              },
              "summer": {
                "$ref": "#/$defs/Range"
              },
              "winter": {
                "$ref": "#/$defs/Range"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "flow": {
            "items": {
              "$ref": "#/$defs/FlowPreference"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "habitat": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "light": {
            "items": {
              "$ref": "#/$defs/LightPreference"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "lures": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "preferred_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Range"
              },
              {
                "type": "null"
              }
            ]
          },
          "regions": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "spawn_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Range"
              },
              {
                "type": "null"
              }
            ]
          },
          "tolerated_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Range"
              },
              {
                "type": "null"
              }
            ]
          },
          "water": {
            "anyOf": [
              {
                "$ref": "#/$defs/WaterKind"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "SpeciesId": {
        "description": "A species, by its lower-case scientific name with hyphens: `morone-saxatilis`.\n\nThe species catalogue keys its profiles by this id. Only lower-case ASCII letters and digits\nin words joined by single hyphens are accepted.",
        "type": "string"
      },
      "SpeciesProfile": {
        "additionalProperties": false,
        "description": "A species profile. Everything but the id and the scientific name is optional: a source may\nknow only some of it, and an empty field is absent, never guessed.",
        "properties": {
          "aliases": {
            "description": "Other names, each with its own source (`FishBase`'s English name is kept here).",
            "items": {
              "$ref": "#/$defs/Sourced"
            },
            "type": "array"
          },
          "common_names": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced2"
              },
              {
                "type": "null"
              }
            ],
            "description": "Anglers' names, the first being the one shown (\"Steelhead\", \"Rainbow trout\")."
          },
          "depth_m": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced5"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where in the water column it is found, metres, by season."
          },
          "flow": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced6"
              },
              {
                "type": "null"
              }
            ]
          },
          "habitat": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced2"
              },
              {
                "type": "null"
              }
            ],
            "description": "Habitat tags such as \"rocky\", \"estuary\" or \"weed edge\"."
          },
          "id": {
            "$ref": "#/$defs/SpeciesId"
          },
          "light": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced7"
              },
              {
                "type": "null"
              }
            ]
          },
          "lures": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced2"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lures and baits, free text."
          },
          "preferred_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced4"
              },
              {
                "type": "null"
              }
            ],
            "description": "Water temperature the fish favours, °C."
          },
          "regions": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced2"
              },
              {
                "type": "null"
              }
            ],
            "description": "Regions it is fished in, free text such as \"Mid-Atlantic\"."
          },
          "scientific_name": {
            "$ref": "#/$defs/Sourced"
          },
          "spawn_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced4"
              },
              {
                "type": "null"
              }
            ],
            "description": "Water temperature at which it spawns, °C."
          },
          "tolerated_temp_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced4"
              },
              {
                "type": "null"
              }
            ],
            "description": "Water temperature the fish tolerates, °C."
          },
          "water": {
            "anyOf": [
              {
                "$ref": "#/$defs/Sourced3"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "scientific_name"
        ],
        "type": "object"
      },
      "SpotShare": {
        "description": "The `kind: \"spot\"` payload: one place and what its owner wrote about it.",
        "properties": {
          "notes": {
            "default": "",
            "type": "string"
          },
          "place": {
            "$ref": "#/$defs/TripPlace"
          }
        },
        "required": [
          "place"
        ],
        "type": "object"
      },
      "Trip": {
        "description": "A trip: places, calendar days, species and method.\n\nNever holds keys, the catch log or photos.",
        "properties": {
          "checklist": {
            "default": [],
            "items": {
              "$ref": "#/$defs/ChecklistItem"
            },
            "type": "array"
          },
          "first": {
            "description": "First day, a calendar date written `2027-07-12`.",
            "type": "string"
          },
          "id": {
            "description": "The host's id (a UUID in the app).",
            "type": "string"
          },
          "last": {
            "description": "Last day, inclusive.",
            "type": "string"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/$defs/TripLimits"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "$ref": "#/$defs/Method"
          },
          "modified_at": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the host last changed the trip, seconds since the Unix epoch."
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "places": {
            "items": {
              "$ref": "#/$defs/TripPlace"
            },
            "type": "array"
          },
          "species": {
            "default": [],
            "items": {
              "$ref": "#/$defs/SpeciesId"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "places",
          "first",
          "last",
          "method",
          "modified_at"
        ],
        "type": "object"
      },
      "TripLimits": {
        "description": "A copy of the angler's limits, so whoever opens a trip sees the same numbers.\n\nIt mirrors the configuration's limits profile field for field, in canonical units (knots for\nwind and current, metres, °C, kilometres) whatever the sender displays.",
        "properties": {
          "max_current_kn": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "max_gust_kn": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "max_wave_m": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "max_wind_kn": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min_air_temp_c": {
            "description": "Coldest air temperature, °C.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min_visibility_km": {
            "description": "Least visibility, km.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "no_lightning": {
            "default": false,
            "type": "boolean"
          },
          "no_small_craft_advisory": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "TripPlace": {
        "description": "One place of a trip.",
        "properties": {
          "area": {
            "description": "The area the spot is grouped under, for example \"Lower Hudson\".",
            "type": [
              "string",
              "null"
            ]
          },
          "fuzz": {
            "$ref": "#/$defs/Fuzz",
            "default": "exact",
            "description": "What the coordinates were reduced to before sharing."
          },
          "latitude": {
            "description": "Degrees north; absent at [`Fuzz::AreaOnly`].",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "description": "Degrees east; absent at [`Fuzz::AreaOnly`].",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "region": {
            "description": "ISO 3166-2 subdivision, for example `US-NY`; the app fills it, the core never geocodes.",
            "type": [
              "string",
              "null"
            ]
          },
          "spot_id": {
            "description": "The host's id for the saved spot.",
            "type": "string"
          },
          "time_zone": {
            "description": "IANA zone name, for example `America/New_York`.",
            "type": "string"
          },
          "water_type": {
            "$ref": "#/$defs/WaterType"
          }
        },
        "required": [
          "spot_id",
          "name",
          "time_zone",
          "water_type"
        ],
        "type": "object"
      },
      "UnixTime": {
        "description": "Seconds since 1970-01-01T00:00:00Z.",
        "format": "int64",
        "type": "integer"
      },
      "WaterKind": {
        "description": "What kind of water a species lives in.",
        "oneOf": [
          {
            "enum": [
              "fresh",
              "salt"
            ],
            "type": "string"
          },
          {
            "const": "both",
            "description": "Both, such as the striped bass or the steelhead.",
            "type": "string"
          }
        ]
      },
      "WaterType": {
        "description": "What kind of water a spot is on. It picks the default cards and source chains.",
        "enum": [
          "river_stream",
          "lake_reservoir",
          "tidal_river_estuary",
          "bay_inshore",
          "surf",
          "nearshore",
          "offshore",
          "great_lakes",
          "pond",
          "ice"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The envelope as a type, for the schema: exactly one payload member matches `kind`.",
    "properties": {
      "format": {
        "type": "string"
      },
      "kind": {
        "$ref": "#/$defs/Kind"
      },
      "layers": {
        "anyOf": [
          {
            "$ref": "#/$defs/LayersShare"
          },
          {
            "type": "null"
          }
        ]
      },
      "profile": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProfileShare"
          },
          {
            "type": "null"
          }
        ]
      },
      "spot": {
        "anyOf": [
          {
            "$ref": "#/$defs/SpotShare"
          },
          {
            "type": "null"
          }
        ]
      },
      "trip": {
        "anyOf": [
          {
            "$ref": "#/$defs/Trip"
          },
          {
            "type": "null"
          }
        ]
      },
      "v": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "format",
      "v",
      "kind"
    ],
    "title": "File",
    "type": "object"
  },
  "Fuzz": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "How much of a place's location a shared file reveals. Ordered from most to least.\n\nThe level a place carries is the level it was fuzzed to, so the receiver can say \"approximate\nlocation\".",
    "oneOf": [
      {
        "const": "exact",
        "description": "The coordinates as saved.",
        "type": "string"
      },
      {
        "const": "rounded_1km",
        "description": "Rounded to 0.01 degrees, about a kilometre. Written `rounded_1km`; the earlier spelling\n`rounded1_km` is still read.",
        "type": "string"
      },
      {
        "const": "area_only",
        "description": "No coordinates; the area and region only.",
        "type": "string"
      }
    ],
    "title": "Fuzz"
  }
}

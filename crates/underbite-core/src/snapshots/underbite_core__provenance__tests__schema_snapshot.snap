        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A station as its source describes it.",
    "properties": {
      "bin": {
        "description": "CO-OPS current bin.",
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": [

        ]
      },
      "id": {
        "description": "The id exactly as the source writes it (`8518750`, `NYH1927`, `USGS-01375000`, `44025`).",
        "type": "string"
      },
      "kind": {
        "$ref": "#/$defs/StationKind",
        "description": "Station type."
      },
      "latitude": {
        "description": "Latitude, degrees north.",
        "format": "double",
        "type": "number"
      },
      "longitude": {

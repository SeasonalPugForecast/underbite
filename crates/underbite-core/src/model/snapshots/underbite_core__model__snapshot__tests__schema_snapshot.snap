          "samples"
        ],
        "type": "object"
      },
      "SkyConditions": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/$defs/SkyDay"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "SkyDay": {
        "properties": {
          "date": {
            "$ref": "#/$defs/LocalDate"
          },
          "moon": {
            "$ref": "#/$defs/MoonDay"
          },
          "solunar": {
            "items": {
              "$ref": "#/$defs/SolunarPeriod"
            },
            "type": "array"
          },
          "sun": {
            "$ref": "#/$defs/SunTimes"
          }
        },
        "required": [
          "date",
          "sun",
          "moon"
        ],
        "type": "object"
      },
      "SolunarCause": {
        "description": "What a solunar period is centred on.",
        "enum": [
          "upper_transit",
          "lower_transit",
          "rise",
          "set"
        ],
        "type": "string"
      },
      "SolunarKind": {
        "enum": [
          "major",
          "minor"
        ],
        "type": "string"
      },
      "SolunarPeriod": {
        "properties": {
          "cause": {
            "$ref": "#/$defs/SolunarCause"
          },
          "end": {
            "$ref": "#/$defs/UnixTime"
          },
          "kind": {
            "$ref": "#/$defs/SolunarKind"
          },
          "start": {
            "$ref": "#/$defs/UnixTime"
          }
        },
        "required": [
          "kind",
          "start",
          "end",
          "cause"
        ],
        "type": "object"
      },
      "SourceError": {
        "description": "A source that failed, with a plain message (\"USGS: rate limited, used NWPS stage\").",
        "properties": {
          "kind": {
            "$ref": "#/$defs/SourceErrorKind"
          },
          "measurement": {
            "anyOf": [
              {
                "$ref": "#/$defs/Measurement"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/SourceId"
          }
        },
        "required": [
          "source",
          "kind",
          "message"
        ],
        "type": "object"
      },
      "SourceErrorKind": {
        "description": "Why a source did not deliver.",
        "enum": [
          "rate_limited",
          "not_found",
          "no_data",
          "stale",
          "parse",
          "transport",
          "other"
        ],
        "type": "string"
      },
      "SourceId": {
        "description": "Identifier of a data source, such as `usgs` or `open-meteo-marine`.\n\nA string newtype rather than an enum so a new source does not change the contract; the\nconfiguration validates ids against the provider registry. Values are kebab-case.",
        "type": "string"
      },
      "Spot": {
        "description": "A saved place.",
        "properties": {
          "id": {
            "type": "string"
          },
          "latitude": {
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "format": "double",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "time_zone": {
            "description": "IANA time-zone name, for example `America/New_York`.",
            "type": "string"
          },
          "water_body": {
            "anyOf": [
              {
                "$ref": "#/$defs/WaterBodyRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "water_type": {
            "$ref": "#/$defs/WaterType"
          }
        },
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "water_type",
          "time_zone"
        ],
        "type": "object"
      },
      "Station": {
        "description": "A weather station that reported the current conditions.",
        "properties": {
          "distance_m": {
            "description": "How far it is from the place, in metres.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "Its identifier, e.g. \"KNYC\".",
            "type": "string"
          },
          "name": {
            "description": "Its name, e.g. \"Central Park\".",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "StationKind": {
        "description": "What kind of station a [`StationRef`] names.",
        "oneOf": [
          {
            "const": "tide_harmonic",
            "description": "CO-OPS harmonic tide prediction station.",
            "type": "string"
          },
          {
            "const": "tide_subordinate",
            "description": "CO-OPS subordinate tide prediction station.",
            "type": "string"
          },
          {
            "const": "current_harmonic",
            "description": "CO-OPS harmonic current prediction station (`H`).",
            "type": "string"
          },
          {
            "const": "current_subordinate",
            "description": "CO-OPS subordinate current prediction station (`S`).",
            "type": "string"
          },
          {
            "const": "current_weak_variable",
            "description": "CO-OPS weak-and-variable current station (`W`).",
            "type": "string"
          },
          {
            "const": "water_level",
            "description": "A water-level gauge.",
            "type": "string"
          },
          {
            "const": "ports_current_meter",
            "description": "A PORTS current meter.",
            "type": "string"
          },
          {
            "const": "buoy",
            "description": "A moored or drifting buoy.",
            "type": "string"
          },
          {
            "const": "cman",
            "description": "A C-MAN coastal station.",
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "A USGS site with its site type.",
            "properties": {
              "usgs_site": {
                "$ref": "#/$defs/UsgsSiteType"
              }
            },
            "required": [
              "usgs_site"
            ],
            "type": "object"
          },
          {
            "const": "nwps_gauge",
            "description": "An NWPS river gauge.",
            "type": "string"
          }
        ]
      },
      "StationRef": {
        "description": "A station as its source describes it.",
        "properties": {
          "bin": {
            "description": "CO-OPS current bin.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "The id exactly as the source writes it (`8518750`, `NYH1927`, `USGS-01375000`, `44025`).",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/StationKind",
            "description": "Station type."
          },
          "latitude": {
            "description": "Latitude, degrees north.",
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "description": "Longitude, degrees east.",
            "format": "double",
            "type": "number"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "reference_id": {
            "description": "Reference station of a subordinate station.",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/$defs/SourceId",
            "description": "The source that owns the station."
          }
        },
        "required": [
          "source",
          "id",
          "name",
          "kind",
          "latitude",
          "longitude"
        ],
        "type": "object"
      },
      "StormOutlook": {
        "description": "Everything the storms view is built from, for one place.",
        "properties": {
          "ensembles": {
            "description": "The ensembles at the place.",
            "items": {
              "$ref": "#/$defs/EnsembleSeries"
            },
            "type": "array"
          },
          "far_hurricanes": {
            "description": "Active cyclones found too far from the place by their official\nforecast, so their tracks aren't read again until their next forecast\nadvisory; empty when none was.",
            "items": {
              "$ref": "#/$defs/FarHurricane"
            },
            "type": "array"
          },
          "fetched_at": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the data was received."
          },
          "grids": {
            "description": "Pressure grids around the place, one per model.",
            "items": {
              "$ref": "#/$defs/PressureGrid"
            },
            "type": "array"
          },
          "hurricanes": {
            "description": "Active tropical cyclones, in NHC's order; empty outside the hurricane\nseason or when none was fetched.",
            "items": {
              "$ref": "#/$defs/Hurricane"
            },
            "type": "array"
          },
          "offset_changes": {
            "description": "UTC offset changes (DST) within the period, ascending; empty when\n`place.utc_offset` applies throughout.",
            "items": {
              "$ref": "#/$defs/OffsetChange"
            },
            "type": "array"
          },
          "past_runs": {
            "description": "Earlier runs' totals fetched with the outlook.",
            "items": {
              "$ref": "#/$defs/PastRun"
            },
            "type": "array"
          },
          "place": {
            "$ref": "#/$defs/ResolvedLocation",
            "description": "The place."
          },
          "points": {
            "description": "The deterministic models at the place, in display order.",
            "items": {
              "$ref": "#/$defs/PointSeries"
            },
            "type": "array"
          }
        },
        "required": [
          "place",
          "points",
          "ensembles",
          "grids",
          "fetched_at"
        ],
        "type": "object"
      },
      "StormWatch": {
        "description": "The storm-ahead subset of whether's storm data and nearby NHC hurricanes.",
        "properties": {
          "checked_at": {
            "$ref": "#/$defs/UnixTime"
          },
          "hurricanes": {
            "description": "Active NHC storms whose cone or track comes within the alert distance.",
            "items": {
              "$ref": "#/$defs/Hurricane"
            },
            "type": "array"
          },
          "point": {
            "anyOf": [
              {
                "$ref": "#/$defs/StormOutlook"
              },
              {
                "type": "null"
              }
            ],
            "description": "Point series and run times only: no ensembles, grids or past runs."
          }
        },
        "required": [
          "checked_at"
        ],
        "type": "object"
      },
      "SunTimes": {
        "description": "Sun times on one local day. Each is absent when the sun never crosses that altitude.",
        "properties": {
          "civil_dawn": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "civil_dusk": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "golden_evening_start": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start of the evening golden hour."
          },
          "golden_morning_end": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ],
            "description": "End of the morning golden hour."
          },
          "nautical_dawn": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "nautical_dusk": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "sunrise": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "sunset": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "TideEvent": {
        "properties": {
          "height_m": {
            "description": "Absent for `ModelMean`, whose curve has no datum heights.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/$defs/TideKind"
          },
          "time": {
            "$ref": "#/$defs/UnixTime"
          }
        },
        "required": [
          "time",
          "kind"
        ],
        "type": "object"
      },
      "TideKind": {
        "enum": [
          "high",
          "low"
        ],
        "type": "string"
      },
      "TideSeries": {
        "description": "Tide predictions (or a modelled curve) with the datum their heights are against.",
        "properties": {
          "curve": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "datum": {
            "$ref": "#/$defs/VerticalDatum"
          },
          "events": {
            "items": {
              "$ref": "#/$defs/TideEvent"
            },
            "type": "array"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ],
            "description": "Observed water level in the same datum."
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "source_kind": {
            "$ref": "#/$defs/TideSourceKind"
          }
        },
        "required": [
          "source_kind",
          "datum",
          "provenance"
        ],
        "type": "object"
      },
      "TideSourceKind": {
        "description": "How a tide series was produced.",
        "oneOf": [
          {
            "enum": [
              "harmonic_station",
              "subordinate_station",
              "computed"
            ],
            "type": "string"
          },
          {
            "const": "model_mean",
            "description": "A model's sea level relative to its own mean: shown without heights.",
            "type": "string"
          }
        ]
      },
      "TrackFix": {
        "description": "One position of a cyclone: observed (past track) or forecast.",
        "properties": {
          "latitude": {
            "description": "Latitude in degrees.",
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "description": "Longitude in degrees, in `-180.0..180.0`.",
            "format": "double",
            "type": "number"
          },
          "pressure_hpa": {
            "description": "The central sea-level pressure, in hPa, when given.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the centre is there."
          },
          "wind_kt": {
            "description": "The maximum sustained wind, in knots, when given.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "time",
          "latitude",
          "longitude"
        ],
        "type": "object"
      },
      "Turbidity": {
        "description": "One turbidity reading with the unit it was measured in.",
        "properties": {
          "unit": {
            "$ref": "#/$defs/TurbidityUnit"
          },
          "value": {
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "type": "object"
      },
      "TurbidityUnit": {
        "description": "The unit a turbidity was measured in. The units are different methods and never convert.",
        "enum": [
          "fnu",
          "ftu",
          "ntu"
        ],
        "type": "string"
      },
      "UnixTime": {
        "description": "Seconds since 1970-01-01T00:00:00Z.",
        "format": "int64",
        "type": "integer"
      },
      "UsgsSiteType": {
        "description": "Type of a USGS monitoring site (`site_type_code`).",
        "oneOf": [
          {
            "const": "stream",
            "description": "`ST`: stream.",
            "type": "string"
          },
          {
            "const": "estuary",
            "description": "`ES`: estuary.",
            "type": "string"
          },
          {
            "const": "lake",
            "description": "`LK`: lake or reservoir.",
            "type": "string"
          },
          {
            "const": "tidal_stream",
            "description": "`ST-TS`: tidal stream.",
            "type": "string"
          },
          {
            "const": "other",
            "description": "Any other site type code.",
            "type": "string"
          }
        ]
      },
      "UtcOffset": {
        "description": "A fixed offset from UTC, in seconds east of UTC.",
        "format": "int32",
        "type": "integer"
      },
      "ValueKind": {
        "description": "How the value was obtained.",
        "oneOf": [
          {
            "const": "observed",
            "description": "Measured.",
            "type": "string"
          },
          {
            "const": "predicted",
            "description": "Predicted from harmonics or tables.",
            "type": "string"
          },
          {
            "const": "modelled",
            "description": "Output of a forecast or analysis model.",
            "type": "string"
          },
          {
            "const": "satellite",
            "description": "Retrieved from satellite imagery.",
            "type": "string"
          },
          {
            "const": "computed",
            "description": "Derived on device from other values.",
            "type": "string"
          }
        ]
      },
      "Vector": {
        "description": "A flow or drift: speed and the direction the water moves **toward**.\n\nThe \"toward\" convention is that of CO-OPS `d` and `meanFloodDir` and Open-Meteo\n`ocean_current_direction`. Wind and waves use \"from\" directions and are separate types.",
        "properties": {
          "speed_ms": {
            "description": "Speed, m/s.",
            "format": "float",
            "type": "number"
          },
          "toward_deg": {
            "description": "Direction the water flows toward, degrees clockwise from true north.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "speed_ms",
          "toward_deg"
        ],
        "type": "object"
      },
      "VerticalDatum": {
        "description": "The reference surface a height is measured from.",
        "oneOf": [
          {
            "const": "mllw",
            "description": "Mean lower-low water, the usual US chart datum.",
            "type": "string"
          },
          {
            "const": "mlw",
            "description": "Mean low water.",
            "type": "string"
          },
          {
            "const": "msl",
            "description": "Mean sea level.",
            "type": "string"
          },
          {
            "const": "mtl",
            "description": "Mean tide level.",
            "type": "string"
          },
          {
            "const": "navd88",
            "description": "North American Vertical Datum of 1988.",
            "type": "string"
          },
          {
            "const": "ngvd29",
            "description": "National Geodetic Vertical Datum of 1929.",
            "type": "string"
          },
          {
            "const": "igld85",
            "description": "International Great Lakes Datum 1985.",
            "type": "string"
          },
          {
            "const": "gauge",
            "description": "A station's own datum (CO-OPS `STND`, a USGS gage datum).",
            "type": "string"
          },
          {
            "const": "model_mean",
            "description": "A model's mean sea level.",
            "type": "string"
          }
        ]
      },
      "WaterBodyRef": {
        "description": "A named water body in a source's own identifier space (for example a 3DHP feature).",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/$defs/SourceId"
          }
        },
        "required": [
          "source",
          "id"
        ],
        "type": "object"
      },
      "WaterConditions": {
        "description": "Water conditions at the spot's stations. Every series carries its own provenance.",
        "properties": {
          "chlorophyll_ug_l": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "clarity_kd490_per_m": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ],
            "description": "Diffuse attenuation coefficient at 490 nm, per metre."
          },
          "conductivity_us_cm": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "cyanobacteria_cells_ml": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "discharge_forecast_m3s": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "discharge_m3s": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "discharge_percentile_for_date": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percentile"
              },
              {
                "type": "null"
              }
            ]
          },
          "dissolved_oxygen_mg_l": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "flood_categories": {
            "anyOf": [
              {
                "$ref": "#/$defs/FloodCategories"
              },
              {
                "type": "null"
              }
            ]
          },
          "gage_height": {
            "anyOf": [
              {
                "$ref": "#/$defs/Heights"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stage above the gauge's datum (`Gauge`, `Ngvd29` or `Navd88` as reported)."
          },
          "level": {
            "anyOf": [
              {
                "$ref": "#/$defs/Heights"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lake or reservoir level."
          },
          "level_percentile_for_date": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percentile"
              },
              {
                "type": "null"
              }
            ]
          },
          "ph": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "salinity_psu": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage_forecast": {
            "anyOf": [
              {
                "$ref": "#/$defs/Heights"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature_c": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ]
          },
          "turbidity": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series2"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "WaterType": {
        "description": "What kind of water a spot is on. It picks the default cards and source chains.",
        "enum": [
          "river_stream",
          "lake_reservoir",
          "tidal_river_estuary",
          "bay_inshore",
          "surf",
          "nearshore",
          "offshore",
          "great_lakes",
          "pond",
          "ice"
        ],
        "type": "string"
      },
      "WaveDirection": {
        "description": "A wave direction: degrees, or a compass point where the source gives only text (NDBC).",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Degrees true the waves come from.",
            "properties": {
              "degrees": {
                "format": "float",
                "type": "number"
              }
            },
            "required": [
              "degrees"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A compass point such as `SSE` the waves come from.",
            "properties": {
              "compass": {
                "type": "string"
              }
            },
            "required": [
              "compass"
            ],
            "type": "object"
          }
        ]
      },
      "WaveSample": {
        "description": "The sea state at one time.",
        "properties": {
          "direction_from_deg": {
            "description": "Degrees true the waves come from.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "dominant_period_s": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "mean_period_s": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "significant_height_m": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "steepness": {
            "description": "NDBC's steepness text (`VERY_STEEP`, `STEEP`, `AVERAGE`, `N/A`).",
            "type": [
              "string",
              "null"
            ]
          },
          "swells": {
            "description": "Zero to three swell trains.",
            "items": {
              "$ref": "#/$defs/WaveTrain"
            },
            "type": "array"
          },
          "wind_waves": {
            "anyOf": [
              {
                "$ref": "#/$defs/WaveTrain"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "WaveTrain": {
        "description": "One wave train: wind waves or a swell.",
        "properties": {
          "direction_from": {
            "anyOf": [
              {
                "$ref": "#/$defs/WaveDirection"
              },
              {
                "type": "null"
              }
            ]
          },
          "height_m": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "period_s": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "WeatherSnapshot": {
        "description": "Everything known about one location's weather from one fetch.",
        "properties": {
          "air_quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/AirQuality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Air quality now."
          },
          "alerts": {
            "description": "Official warnings.",
            "items": {
              "$ref": "#/$defs/Alert"
            },
            "type": "array"
          },
          "current": {
            "anyOf": [
              {
                "$ref": "#/$defs/Current"
              },
              {
                "type": "null"
              }
            ],
            "description": "Conditions now."
          },
          "daily": {
            "description": "Ascending local days.",
            "items": {
              "$ref": "#/$defs/Daily"
            },
            "type": "array"
          },
          "fetched_at": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the data was received."
          },
          "hourly": {
            "description": "Ascending forecast steps.",
            "items": {
              "$ref": "#/$defs/Hourly"
            },
            "type": "array"
          },
          "location": {
            "$ref": "#/$defs/ResolvedLocation",
            "description": "Where the data applies."
          },
          "minutely_1": {
            "description": "Ascending one-minute precipitation steps for the next hour, from a minute\nnowcast the app adds (Apple's WeatherKit on the iPhone); usually\nempty.",
            "items": {
              "$ref": "#/$defs/Minutely"
            },
            "type": "array"
          },
          "minutely_15": {
            "description": "Ascending 15-minute precipitation steps; may be empty.",
            "items": {
              "$ref": "#/$defs/Minutely"
            },
            "type": "array"
          },
          "models": {
            "description": "The weather models that supplied the forecast, in priority order (Open-Meteo\nids); empty when the provider chose its own.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "offset_changes": {
            "default": [],
            "description": "UTC offset changes (DST) within the forecast period, ascending; empty when\none offset (`location.utc_offset`) applies throughout.",
            "items": {
              "$ref": "#/$defs/OffsetChange"
            },
            "type": "array"
          },
          "provider": {
            "$ref": "#/$defs/ProviderId",
            "description": "The primary source."
          },
          "supplemented_by": {
            "description": "Providers that filled gaps; all are credited.",
            "items": {
              "$ref": "#/$defs/ProviderId"
            },
            "type": "array"
          }
        },
        "required": [
          "location",
          "provider",
          "supplemented_by",
          "fetched_at",
          "hourly",
          "daily",
          "minutely_15",
          "alerts"
        ],
        "type": "object"
      },
      "Wind": {
        "description": "Wind at a station.",
        "properties": {
          "from_deg": {
            "description": "Degrees true the wind blows from.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "gust_ms": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "speed_ms": {
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "speed_ms"
        ],
        "type": "object"
      },
      "ZoneForecast": {
        "description": "An NWS marine zone forecast: text only, never parsed into numbers.",
        "properties": {
          "id": {
            "type": "string"
          },
          "issued": {
            "$ref": "#/$defs/UnixTime"
          },
          "kind": {
            "$ref": "#/$defs/ZoneKind"
          },
          "name": {
            "type": "string"
          },
          "periods": {
            "items": {
              "$ref": "#/$defs/ForecastPeriod"
            },
            "type": "array"
          },
          "product": {
            "$ref": "#/$defs/ZoneProduct"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "issued",
          "product",
          "periods"
        ],
        "type": "object"
      },
      "ZoneKind": {
        "enum": [
          "coastal",
          "great_lakes_nearshore",
          "great_lakes_open",
          "offshore"
        ],
        "type": "string"
      },
      "ZoneProduct": {
        "description": "The NWS product a forecast came from.",
        "enum": [
          "zone_api",
          "cwf",
          "nsh",
          "glf",
          "off"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Everything known about one spot at one moment.",
    "properties": {
      "attribution": {
        "items": {
          "$ref": "#/$defs/Attribution"
        },
        "type": "array"
      },
      "errors": {
        "items": {
          "$ref": "#/$defs/SourceError"
        },
        "type": "array"
      },
      "fetched_at": {
        "$ref": "#/$defs/UnixTime"
      },
      "marine": {
        "$ref": "#/$defs/MarineConditions"
      },
      "sky": {
        "$ref": "#/$defs/SkyConditions"
      },
      "spot": {
        "$ref": "#/$defs/Spot"
      },
      "stations": {
        "description": "The stations the values came from.",
        "items": {
          "$ref": "#/$defs/StationRef"
        },
        "type": "array"
      },
      "storm": {
        "anyOf": [
          {
            "$ref": "#/$defs/StormWatch"
          },
          {
            "type": "null"
          }
        ]
      },
      "water": {
        "$ref": "#/$defs/WaterConditions"
      },
      "weather": {
        "anyOf": [
          {
            "$ref": "#/$defs/WeatherSnapshot"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "spot",
      "fetched_at"
    ],
    "title": "SpotSnapshot",
    "type": "object"
  },
  "StationCandidate": {
    "$defs": {
      "Coverage": {
        "description": "What a station offers for one measurement.",
        "properties": {
          "last_value_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "primary": {
            "description": "The station's primary product for this measurement.",
            "type": "boolean"
          }
        },
        "required": [
          "primary"
        ],
        "type": "object"
      },
      "SourceId": {
        "description": "Identifier of a data source, such as `usgs` or `open-meteo-marine`.\n\nA string newtype rather than an enum so a new source does not change the contract; the\nconfiguration validates ids against the provider registry. Values are kebab-case.",
        "type": "string"
      },
      "StationKind": {
        "description": "What kind of station a [`StationRef`] names.",
        "oneOf": [
          {
            "const": "tide_harmonic",
            "description": "CO-OPS harmonic tide prediction station.",
            "type": "string"
          },
          {
            "const": "tide_subordinate",
            "description": "CO-OPS subordinate tide prediction station.",
            "type": "string"
          },
          {
            "const": "current_harmonic",
            "description": "CO-OPS harmonic current prediction station (`H`).",
            "type": "string"
          },
          {
            "const": "current_subordinate",
            "description": "CO-OPS subordinate current prediction station (`S`).",
            "type": "string"
          },
          {
            "const": "current_weak_variable",
            "description": "CO-OPS weak-and-variable current station (`W`).",
            "type": "string"
          },
          {
            "const": "water_level",
            "description": "A water-level gauge.",
            "type": "string"
          },
          {
            "const": "ports_current_meter",
            "description": "A PORTS current meter.",
            "type": "string"
          },
          {
            "const": "buoy",
            "description": "A moored or drifting buoy.",
            "type": "string"
          },
          {
            "const": "cman",
            "description": "A C-MAN coastal station.",
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "A USGS site with its site type.",
            "properties": {
              "usgs_site": {
                "$ref": "#/$defs/UsgsSiteType"
              }
            },
            "required": [
              "usgs_site"
            ],
            "type": "object"
          },
          {
            "const": "nwps_gauge",
            "description": "An NWPS river gauge.",
            "type": "string"
          }
        ]
      },
      "StationRef": {
        "description": "A station as its source describes it.",
        "properties": {
          "bin": {
            "description": "CO-OPS current bin.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "The id exactly as the source writes it (`8518750`, `NYH1927`, `USGS-01375000`, `44025`).",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/StationKind",
            "description": "Station type."
          },
          "latitude": {
            "description": "Latitude, degrees north.",
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "description": "Longitude, degrees east.",
            "format": "double",
            "type": "number"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "reference_id": {
            "description": "Reference station of a subordinate station.",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/$defs/SourceId",
            "description": "The source that owns the station."
          }
        },
        "required": [
          "source",
          "id",
          "name",
          "kind",
          "latitude",
          "longitude"
        ],
        "type": "object"
      },
      "UnixTime": {
        "description": "Seconds since 1970-01-01T00:00:00Z.",
        "format": "int64",
        "type": "integer"
      },
      "UsgsSiteType": {
        "description": "Type of a USGS monitoring site (`site_type_code`).",
        "oneOf": [
          {
            "const": "stream",
            "description": "`ST`: stream.",
            "type": "string"
          },
          {
            "const": "estuary",
            "description": "`ES`: estuary.",
            "type": "string"
          },
          {
            "const": "lake",
            "description": "`LK`: lake or reservoir.",
            "type": "string"
          },
          {
            "const": "tidal_stream",
            "description": "`ST-TS`: tidal stream.",
            "type": "string"
          },
          {
            "const": "other",
            "description": "Any other site type code.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A station found near a spot and what it offers.",
    "properties": {
      "offers": {
        "additionalProperties": false,
        "properties": {
          "chlorophyll": {
            "$ref": "#/$defs/Coverage"
          },
          "clarity": {
            "$ref": "#/$defs/Coverage"
          },
          "conductivity": {
            "$ref": "#/$defs/Coverage"
          },
          "cyanobacteria": {
            "$ref": "#/$defs/Coverage"
          },
          "discharge": {
            "$ref": "#/$defs/Coverage"
          },
          "dissolved_oxygen": {
            "$ref": "#/$defs/Coverage"
          },
          "flood_categories": {
            "$ref": "#/$defs/Coverage"
          },
          "flow_forecast": {
            "$ref": "#/$defs/Coverage"
          },
          "gage_height": {
            "$ref": "#/$defs/Coverage"
          },
          "lake_level": {
            "$ref": "#/$defs/Coverage"
          },
          "marine_alerts": {
            "$ref": "#/$defs/Coverage"
          },
          "marine_forecast": {
            "$ref": "#/$defs/Coverage"
          },
          "observed_pressure": {
            "$ref": "#/$defs/Coverage"
          },
          "observed_wind": {
            "$ref": "#/$defs/Coverage"
          },
          "ocean_current": {
            "$ref": "#/$defs/Coverage"
          },
          "ph": {
            "$ref": "#/$defs/Coverage"
          },
          "salinity": {
            "$ref": "#/$defs/Coverage"
          },
          "sea_surface_temp": {
            "$ref": "#/$defs/Coverage"
          },
          "sea_surface_temp_forecast": {
            "$ref": "#/$defs/Coverage"
          },
          "tidal_current": {
            "$ref": "#/$defs/Coverage"
          },
          "tide": {
            "$ref": "#/$defs/Coverage"
          },
          "turbidity": {
            "$ref": "#/$defs/Coverage"
          },
          "water_temperature": {
            "$ref": "#/$defs/Coverage"
          },
          "waves": {
            "$ref": "#/$defs/Coverage"
          },
          "waves_forecast": {
            "$ref": "#/$defs/Coverage"
          }
        },
        "type": "object"
      },
      "station": {
        "$ref": "#/$defs/StationRef"
      }
    },
    "required": [
      "station",
      "offers"
    ],
    "title": "StationCandidate",
    "type": "object"
  }
}

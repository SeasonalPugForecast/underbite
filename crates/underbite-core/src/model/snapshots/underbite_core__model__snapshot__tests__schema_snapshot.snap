        ],
        "type": "object"
      },
      "Series": {
        "description": "Samples of one quantity from one provenance.\n\nSamples are sorted ascending by time with no duplicate times; [`Series::new`] and\ndeserialization enforce this.",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "samples": {
            "items": {
              "$ref": "#/$defs/Sample"
            },
            "type": "array"
          }
        },
        "required": [
          "provenance",
          "samples"
        ],
        "type": "object"
      },
      "Series2": {
        "description": "Samples of one quantity from one provenance.\n\nSamples are sorted ascending by time with no duplicate times; [`Series::new`] and\ndeserialization enforce this.",
        "properties": {
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "samples": {
            "items": {
              "$ref": "#/$defs/Sample2"
            },
            "type": "array"
          }
        },
        "required": [
          "provenance",
          "samples"
        ],
        "type": "object"
      },
      "Series3": {
        "description": "Samples of one quantity from one provenance.\n\nSamples are sorted ascending by time with no duplicate times; [`Series::new`] and\ndeserialization enforce this.",
        "properties": {

      "Percent": {
        "description": "A percentage in `0.0..=100.0`.",
        "format": "float",
        "type": "number"
      },
      "Percentile": {
        "description": "A current value placed among the normals for its day of year. Values are in the\ncanonical unit of the quantity (m³/s for discharge, metres for level).",
        "properties": {
          "approved_only": {
            "type": "boolean"
          },
          "basis": {
            "$ref": "#/$defs/PercentileBasis"
          },
          "class": {
            "anyOf": [
              {
                "$ref": "#/$defs/PercentileClass"
              },
              {
                "type": "null"
              }
            ]
          },
          "day_of_year": {
            "description": "Day of year as `MM-DD`.",
            "type": "string"
          },
          "max": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "mean": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "rank": {
            "description": "Percentile rank of `value` (0 to 100), interpolated between the thresholds.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "sample_count": {
            "description": "Number of years in the sample.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "thresholds": {
            "$ref": "#/$defs/PercentileThresholds"
          },
          "value": {
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "day_of_year",
          "thresholds",
          "value",
          "basis",
          "sample_count",
          "approved_only"
        ],
        "type": "object"
      },
      "PercentileBasis": {
        "description": "Where a [`Percentile`] came from.",
        "oneOf": [
          {
            "const": "statistics_api",
            "description": "The USGS Statistics API's day-of-year normals.",
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "Computed on the device from the daily record of `years` years.",
            "properties": {
              "computed_from_daily": {
                "properties": {
                  "years": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "years"
                ],
                "type": "object"
              }
            },
            "required": [
              "computed_from_daily"
            ],
            "type": "object"
          }
        ]
      },
      "PercentileClass": {
        "description": "WaterWatch-style class of a value among its day-of-year percentiles. The bounds live in\nthe derivation, not here.",
        "enum": [
          "much_below_normal",
          "below_normal",
          "normal",
          "above_normal",
          "much_above_normal"
        ],
        "type": "string"
      },
      "PercentileThresholds": {
        "description": "The 5, 10, 25, 50, 75, 90 and 95th percentile values for a day of year.",

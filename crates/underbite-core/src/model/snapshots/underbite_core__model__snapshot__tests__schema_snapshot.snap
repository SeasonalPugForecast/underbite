---
source: crates/underbite-core/src/model/snapshot.rs
expression: schemas
---
{
  "Requirements": {
    "$defs": {
      "Measurement": {
        "description": "A kind of value the app can show; the key of source chains, discovery and requirements.",
        "enum": [
          "water_temperature",
          "discharge",
          "gage_height",
          "lake_level",
          "turbidity",
          "dissolved_oxygen",
          "conductivity",
          "salinity",
          "ph",
          "chlorophyll",
          "clarity",
          "cyanobacteria",
          "tide",
          "tidal_current",
          "ocean_current",
          "waves",
          "waves_forecast",
          "sea_surface_temp",
          "sea_surface_temp_forecast",
          "marine_forecast",
          "marine_alerts",
          "flood_categories",
          "flow_forecast",
          "observed_wind",
          "observed_pressure"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "What a refresh must fetch: the measurements wanted and how far back and ahead.",
    "properties": {
      "future_days": {
        "default": 7,
        "description": "Future window in days, for predictions.",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "measurements": {
        "items": {
          "$ref": "#/$defs/Measurement"
        },
        "type": "array",
        "uniqueItems": true
      },
      "past_hours": {
        "default": 168,
        "description": "Past window in hours, for sparklines (7 days by default).",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "title": "Requirements",
    "type": "object"
  },
  "SpotSnapshot": {
    "$defs": {
      "AirQuality": {
        "description": "Air quality now. Pollutants are in µg/m³.",
        "properties": {
          "co": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "european_aqi": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "no2": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "o3": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "owm_index": {
            "description": "OpenWeather's 1–5 index.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "pm10": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "pm2_5": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "so2": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "time": {
            "$ref": "#/$defs/UnixTime"
          },
          "us_aqi": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "time"
        ],
        "type": "object"
      },
      "Alert": {
        "description": "An official weather warning.",
        "properties": {
          "checked_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the provider last sent this alert's details (`None` when unknown, as in\ncaches written before this change). A fetch re-requests details older than an hour\nso updates reach the app while the alert lasts."
          },
          "description": {
            "type": "string"
          },
          "end": {
            "$ref": "#/$defs/UnixTime"
          },
          "id": {
            "description": "The provider's identifier, when it has one: deduplicates alerts and lets a\nlater fetch reuse details it already has.",
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "$ref": "#/$defs/Level"
          },
          "source": {
            "type": "string"
          },
          "start": {
            "$ref": "#/$defs/UnixTime"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "description": "A page with the alert's details, when the source gives one.\nCaches written earlier have none.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title",
          "description",
          "severity",
          "start",
          "end",
          "source"
        ],
        "type": "object"
      },
      "AlertSeverity": {
        "description": "NWS alert severity.",
        "enum": [
          "extreme",
          "severe",
          "moderate",
          "minor",
          "unknown"
        ],
        "type": "string"
      },
      "Attribution": {
        "description": "The credit a display owes a source.",
        "properties": {
          "credit": {
            "description": "Credit text as the source requires it.",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/SourceId",
            "description": "The source credited."
          },
          "url": {
            "description": "Link to the source or its terms.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "credit"
        ],
        "type": "object"
      },
      "Basin": {
        "description": "The NHC basin a cyclone is in.",
        "oneOf": [
          {
            "const": "atlantic",
            "description": "The North Atlantic, the Caribbean and the Gulf (`al`).",
            "type": "string"
          },
          {
            "const": "east_pacific",
            "description": "The eastern North Pacific (`ep`).",
            "type": "string"
          },
          {
            "const": "central_pacific",
            "description": "The central North Pacific (`cp`).",
            "type": "string"
          }
        ]
      },
      "Celsius": {
        "description": "Temperature in degrees Celsius.",
        "format": "float",
        "type": "number"
      },
      "Condition": {
        "description": "Sky and precipitation state, normalized across WMO codes, OpenWeather ids and\nMET Norway symbol codes.",
        "oneOf": [
          {
            "enum": [
              "clear",
              "mainly_clear",
              "partly_cloudy",
              "cloudy",
              "overcast",
              "fog",
              "haze",
              "smoke",
              "dust",
              "snow_grains",
              "squall",
              "tornado",
              "unknown"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "drizzle": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "drizzle"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "freezing_drizzle": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "freezing_drizzle"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "rain": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "rain"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "freezing_rain": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "freezing_rain"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "rain_showers": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "rain_showers"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "sleet": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "sleet"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "sleet_showers": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "sleet_showers"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "snow": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "snow"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "snow_showers": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "snow_showers"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "thunderstorm": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "thunderstorm"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "thunderstorm_hail": {
                "$ref": "#/$defs/Intensity"
              }
            },
            "required": [
              "thunderstorm_hail"
            ],
            "type": "object"
          }
        ]
      },
      "Current": {
        "description": "Conditions now.",
        "properties": {
          "apparent": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "cloud_cover": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "$ref": "#/$defs/Condition"
          },
          "dew_point": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "humidity": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_day": {
            "type": "boolean"
          },
          "precipitation": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mm"
              },
              {
                "type": "null"
              }
            ]
          },
          "pressure_msl": {
            "anyOf": [
              {
                "$ref": "#/$defs/Hpa"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "time": {
            "$ref": "#/$defs/UnixTime"
          },
          "uv_index": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "visibility": {
            "anyOf": [
              {
                "$ref": "#/$defs/Meters"
              },
              {
                "type": "null"
              }
            ]
          },
          "wind_dir": {
            "anyOf": [
              {
                "$ref": "#/$defs/Degrees"
              },
              {
                "type": "null"
              }
            ]
          },
          "wind_gust": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mps"
              },
              {
                "type": "null"
              }
            ]
          },
          "wind_speed": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mps"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "time",
          "is_day",
          "condition"
        ],
        "type": "object"
      },
      "CurrentEvent": {
        "properties": {
          "kind": {
            "$ref": "#/$defs/CurrentKind"
          },
          "speed_ms": {
            "description": "Signed along the major axis, positive toward flood.",
            "format": "float",
            "type": "number"
          },
          "time": {
            "$ref": "#/$defs/UnixTime"
          }
        },
        "required": [
          "time",
          "kind",
          "speed_ms"
        ],
        "type": "object"
      },
      "CurrentKind": {
        "enum": [
          "max_flood",
          "max_ebb",
          "slack"
        ],
        "type": "string"
      },
      "CurrentSeries": {
        "description": "Tidal current predictions and observations at a station.",
        "properties": {
          "bin": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "curve": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signed major-axis speed in m/s, positive toward flood."
          },
          "depth_m": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "ebb_dir_deg": {
            "description": "Direction the ebb sets toward, degrees true.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "events": {
            "items": {
              "$ref": "#/$defs/CurrentEvent"
            },
            "type": "array"
          },
          "flood_dir_deg": {
            "description": "Direction the flood sets toward, degrees true.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/Series3"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "provenance"
        ],
        "type": "object"
      },
      "Daily": {
        "description": "One local calendar day.",
        "properties": {
          "apparent_max": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ],
            "description": "The day's highest and lowest \"feels like\" temperatures."
          },
          "apparent_min": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "$ref": "#/$defs/Condition"
          },
          "date": {
            "$ref": "#/$defs/LocalDate"
          },
          "daylight_s": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "moon_phase": {
            "description": "Phase fraction: 0 new, 0.5 full.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "moonrise": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "moonset": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "precip_probability_max": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "precip_sum": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mm"
              },
              {
                "type": "null"
              }
            ]
          },
          "sunrise": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "sunset": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "temp_max": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "temp_min": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "uv_index_max": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "wind_dir_dominant": {
            "anyOf": [
              {
                "$ref": "#/$defs/Degrees"
              },
              {
                "type": "null"
              }
            ]
          },
          "wind_gust_max": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mps"
              },
              {
                "type": "null"
              }
            ]
          },
          "wind_speed_max": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mps"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "condition"
        ],
        "type": "object"
      },
      "Degrees": {
        "description": "An angle in degrees; for wind, the direction the wind blows *from*.",
        "format": "float",
        "type": "number"
      },
      "EnsembleSeries": {
        "description": "One ensemble's members at the place.\n\nMember 0 is the control run. Each member's vector has one entry per entry\nof `times`.",
        "properties": {
          "model": {
            "description": "The Open-Meteo Ensemble API `models` id, e.g. `gfs025`.",
            "type": "string"
          },
          "precipitation_mm": {
            "description": "Precipitation in the hour before each time, in millimetres, as\n`[member][time]`.",
            "items": {
              "items": {
                "format": "float",
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "run": {
            "anyOf": [
              {
                "$ref": "#/$defs/ModelRun"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run the members come from, when known."
          },
          "snowfall_cm": {
            "description": "Snowfall in the hour before each time, in centimetres, as\n`[member][time]`.",
            "items": {
              "items": {
                "format": "float",
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "times": {
            "description": "Ascending, hourly.",
            "items": {
              "$ref": "#/$defs/UnixTime"
            },
            "type": "array"
          }
        },
        "required": [
          "model",
          "times",
          "precipitation_mm",
          "snowfall_cm"
        ],
        "type": "object"
      },
      "FarHurricane": {
        "description": "An active cyclone whose official forecast, as of one forecast advisory,\nstays too far from the place to be drawn: it need not be looked at again\nuntil NHC's next forecast advisory.",
        "properties": {
          "forecast_advisory_time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the forecast advisory it was judged by was issued."
          },
          "id": {
            "description": "NHC's id, e.g. `al102026`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "forecast_advisory_time"
        ],
        "type": "object"
      },
      "FloodCategories": {
        "description": "NWPS flood stage thresholds, each absent when the gauge does not define it.",
        "properties": {
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/Height"
              },
              {
                "type": "null"
              }
            ]
          },
          "major": {
            "anyOf": [
              {
                "$ref": "#/$defs/Height"
              },
              {
                "type": "null"
              }
            ]
          },
          "minor": {
            "anyOf": [
              {
                "$ref": "#/$defs/Height"
              },
              {
                "type": "null"
              }
            ]
          },
          "moderate": {
            "anyOf": [
              {
                "$ref": "#/$defs/Height"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "ForecastPeriod": {
        "description": "One named period of a text forecast.",
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "text"
        ],
        "type": "object"
      },
      "Height": {
        "description": "A height in metres above a datum.",
        "properties": {
          "datum": {
            "$ref": "#/$defs/VerticalDatum",
            "description": "The datum the height is measured from."
          },
          "metres": {
            "description": "Height above the datum, metres.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "datum",
          "metres"
        ],
        "type": "object"
      },
      "Heights": {
        "description": "A series of heights, metres above one datum.",
        "properties": {
          "datum": {
            "$ref": "#/$defs/VerticalDatum",
            "description": "The datum of every sample."
          },
          "series": {
            "$ref": "#/$defs/Series",
            "description": "Heights above the datum, metres."
          }
        },
        "required": [
          "datum",
          "series"
        ],
        "type": "object"
      },
      "Hourly": {
        "description": "One forecast step (1 h; 3 h for OpenWeather's free API).",
        "properties": {
          "apparent": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "cloud_cover": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "$ref": "#/$defs/Condition"
          },
          "humidity": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_day": {
            "type": "boolean"
          },
          "precip_probability": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "precipitation": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mm"
              },
              {
                "type": "null"
              }
            ]
          },
          "pressure_msl": {
            "anyOf": [
              {
                "$ref": "#/$defs/Hpa"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature": {
            "anyOf": [
              {
                "$ref": "#/$defs/Celsius"
              },
              {
                "type": "null"
              }
            ]
          },
          "time": {

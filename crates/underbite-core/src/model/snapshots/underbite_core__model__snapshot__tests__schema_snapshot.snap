          "snowfall_cm",
          "gust_kmh",
          "pressure_hpa"
        ],
        "type": "object"
      },
      "PressureGrid": {
        "description": "One model's sea-level pressure on a regular grid around the place.\n\nPoints are stored row by row: the point at `row` (an index into `lats`)\nand `col` (an index into `lons`) is `row * lons.len() + col`.",
        "properties": {
          "lats": {
            "description": "Row latitudes in degrees, south to north.",
            "items": {
              "format": "float",
              "type": "number"
            },
            "type": "array"
          },
          "lons": {
            "description": "Column longitudes in degrees, west to east, each in `-180.0..180.0`;\na grid across the antimeridian wraps from 180 to -180 between two\ncolumns.",
            "items": {
              "format": "float",
              "type": "number"
            },
            "type": "array"
          },
          "model": {
            "description": "The Open-Meteo `models` id.",
            "type": "string"
          },
          "pressure_hpa": {
            "description": "Mean sea-level pressure in hectopascals, as `[time][point]`.",
            "items": {
              "items": {
                "format": "float",
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "run": {
            "anyOf": [
              {
                "$ref": "#/$defs/ModelRun"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run the grid comes from, when known."
          },
          "times": {
            "description": "Ascending, usually 6 hours apart.",
            "items": {
              "$ref": "#/$defs/UnixTime"
            },
            "type": "array"
          }
        },
        "required": [
          "model",
          "lats",
          "lons",
          "times",
          "pressure_hpa"
        ],
        "type": "object"
      },
      "PrincipalPhase": {
        "enum": [
          "new",
          "first_quarter",
          "full",
          "last_quarter"
        ],
        "type": "string"
      },
      "PrincipalPhaseTime": {
        "description": "A principal phase and the instant it happens.",
        "properties": {
          "phase": {
            "$ref": "#/$defs/PrincipalPhase"
          },
          "time": {
            "$ref": "#/$defs/UnixTime"
          }
        },
        "required": [
          "phase",
          "time"
        ],
        "type": "object"
      },
      "Provenance": {
        "description": "Where one value or series came from.",
        "properties": {
          "distance_m": {
            "description": "Distance from the spot to the station, metres.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/$defs/ValueKind",
            "description": "Observed, predicted, modelled, satellite or computed."
          },
          "observed_at": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the value was observed, predicted for or issued."
          },
          "quality": {
            "$ref": "#/$defs/Quality",
            "description": "Source-reported quality."
          },
          "relation": {
            "$ref": "#/$defs/Relation",
            "description": "How the station relates to the spot."
          },
          "source": {
            "$ref": "#/$defs/SourceId",
            "description": "The data source."
          },
          "station": {
            "anyOf": [
              {
                "$ref": "#/$defs/StationRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "The station, when the value comes from one."
          }
        },
        "required": [
          "source",
          "relation",
          "observed_at",
          "kind",
          "quality"
        ],
        "type": "object"
      },
      "ProviderId": {
        "description": "A weather data provider.",
        "oneOf": [
          {
            "const": "openweather",
            "description": "OpenWeather (openweathermap.org).",
            "type": "string"
          },
          {
            "const": "open-meteo",
            "description": "Open-Meteo (open-meteo.com).",
            "type": "string"
          },
          {
            "const": "met-norway",
            "description": "MET Norway (api.met.no).",
            "type": "string"
          },
          {
            "const": "nws",
            "description": "The US National Weather Service (api.weather.gov): official alerts as a\nsupplement, and the forecast as a primary provider.",
            "type": "string"
          },
          {
            "const": "acis",
            "description": "NOAA's Regional Climate Centers (data.rcc-acis.org): station history,\nnormals and records for US places; never a forecast.",
            "type": "string"
          },
          {
            "const": "pirate-weather",
            "description": "Pirate Weather (pirateweather.net): a keyed Dark Sky-style forecast from a\nblend of NOAA and other models, billed per month.",
            "type": "string"
          }
        ]
      },
      "Quality": {
        "description": "Quality of a value, as far as the source says.",
        "oneOf": [
          {
            "const": "provisional",
            "description": "Subject to revision.",
            "type": "string"
          },
          {
            "const": "approved",
            "description": "Reviewed and approved.",
            "type": "string"
          },
          {
            "const": "estimated",
            "description": "Estimated by the source (USGS `ESTIMATED`).",
            "type": "string"
          },
          {
            "const": "ice_affected",
            "description": "Affected by ice (USGS `ICE`).",
            "type": "string"
          },
          {
            "const": "flagged",
            "description": "Unreliable: equipment or maintenance (USGS `EQUIP`, `MAINT`).",
            "type": "string"
          }
        ]
      },
      "Relation": {
        "description": "How the station relates to the spot.",
        "oneOf": [
          {
            "const": "same_water_body",
            "description": "On the same water body as the spot.",
            "type": "string"
          },
          {
            "const": "upstream",
            "description": "Upstream of the spot on the same river.",
            "type": "string"
          },
          {
            "const": "downstream",
            "description": "Downstream of the spot on the same river.",
            "type": "string"
          },
          {
            "const": "nearby",
            "description": "Close by, water body not established.",
            "type": "string"
          },
          {
            "const": "gridded",
            "description": "A model grid cell.",
            "type": "string"
          },
          {
            "const": "satellite",
            "description": "A satellite pixel.",
            "type": "string"
          }
        ]
      },
      "ResolvedLocation": {
        "description": "A location resolved to coordinates and a UTC offset.",
        "properties": {
          "elevation_m": {
            "description": "Elevation in metres.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "latitude": {
            "description": "Latitude in degrees.",
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "description": "Longitude in degrees.",
            "format": "double",
            "type": "number"
          },
          "name": {
            "description": "Display name, e.g. \"New York\".",
            "type": "string"
          },
          "region": {
            "description": "Region line, e.g. \"New York, US\".",
            "type": [
              "string",
              "null"
            ]
          },
          "station": {
            "anyOf": [
              {
                "$ref": "#/$defs/Station"
              },
              {
                "type": "null"
              }
            ],
            "description": "The weather station whose observation gave the current conditions\n(the NWS); `None` when they are a forecast."
          },
          "tz_abbrev": {
            "description": "Time-zone abbreviation, e.g. \"EDT\".",
            "type": [
              "string",
              "null"
            ]
          },
          "tz_name": {
            "description": "IANA time-zone name, when known.",
            "type": [
              "string",
              "null"
            ]
          },
          "utc_offset": {
            "$ref": "#/$defs/UtcOffset",
            "description": "The location's UTC offset at fetch time."
          }
        },
        "required": [
          "name",
          "latitude",
          "longitude",
          "utc_offset"
        ],
        "type": "object"
      },
      "Sample": {
        "description": "One value at one instant.",
        "properties": {
          "quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-sample quality, overriding the series provenance (USGS qualifiers vary per value)."
          },
          "time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the value applies, UTC."
          },
          "value": {
            "description": "The value, in canonical units.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "time",
          "value"
        ],
        "type": "object"
      },
      "Sample2": {
        "description": "One value at one instant.",
        "properties": {
          "quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-sample quality, overriding the series provenance (USGS qualifiers vary per value)."
          },
          "time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the value applies, UTC."
          },
          "value": {
            "$ref": "#/$defs/Turbidity",
            "description": "The value, in canonical units."
          }
        },
        "required": [
          "time",
          "value"
        ],
        "type": "object"
      },
      "Sample3": {
        "description": "One value at one instant.",
        "properties": {
          "quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-sample quality, overriding the series provenance (USGS qualifiers vary per value)."
          },
          "time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the value applies, UTC."
          },
          "value": {
            "$ref": "#/$defs/Vector",
            "description": "The value, in canonical units."
          }
        },
        "required": [
          "time",

      "Hpa": {
        "description": "Pressure in hectopascals.",
        "format": "float",
        "type": "number"
      },
      "Hurricane": {
        "description": "One active cyclone: NHC's latest advisory with its tracks.",
        "properties": {
          "advisory_time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the latest public advisory was issued."
          },
          "advisory_url": {
            "description": "The latest public advisory's web page.",
            "type": [
              "string",
              "null"
            ]
          },
          "aids": {
            "additionalProperties": {
              "items": {
                "$ref": "#/$defs/TrackFix"
              },
              "type": "array"
            },
            "default": {},
            "description": "The guidance models' latest tracks by ATCF aid code (see\n[`DRAWN_AIDS`]).",
            "type": "object"
          },
          "basin": {
            "$ref": "#/$defs/Basin",
            "description": "The basin."
          },
          "classification": {
            "description": "NHC's classification code: `HU` (hurricane), `TS` (tropical storm),\n`TD` (tropical depression), `STS` and `STD` (subtropical storm and\ndepression), `PTC` (post-tropical cyclone), `PC` (potential tropical\ncyclone) or `TY` (typhoon).",
            "type": "string"
          },
          "forecast_advisory_time": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When NHC issued the forecast advisory the tracks belong with: the\nofficial forecast changes only with it (public advisories between\ntwo keep it). `None` in outlooks from before it was kept."
          },
          "id": {
            "description": "NHC's id: basin, number and year, e.g. `al102026`.",
            "type": "string"
          },
          "latitude": {
            "description": "The centre's latitude, in degrees.",
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "description": "The centre's longitude, in degrees, in `-180.0..180.0`.",
            "format": "double",
            "type": "number"
          },
          "movement_deg": {
            "description": "Where the centre is heading, in degrees clockwise from north.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "movement_kt": {
            "description": "How fast the centre moves, in knots.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "description": "The name, e.g. \"Josephine\", or the number for an unnamed depression.",
            "type": "string"
          },
          "official": {
            "default": [],
            "description": "NHC's official forecast track, from the advisory's position on.",
            "items": {
              "$ref": "#/$defs/TrackFix"
            },
            "type": "array"
          },
          "official_init": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnixTime"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When the official forecast's run started (`None` without one):\nthe synoptic hour before its forecast advisory, so an older one is\nan earlier advisory's (see [`Hurricane::official_is_current`])."
          },
          "past": {
            "default": [],
            "description": "The observed (best) track, oldest first.",
            "items": {
              "$ref": "#/$defs/TrackFix"
            },
            "type": "array"
          },
          "pressure_hpa": {
            "description": "The central pressure, in hPa.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "wind_kt": {
            "description": "The maximum sustained wind, in knots.",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "classification",
          "basin",
          "latitude",
          "longitude",
          "advisory_time"
        ],
        "type": "object"
      },
      "Intensity": {
        "description": "Strength of precipitation or a storm.",

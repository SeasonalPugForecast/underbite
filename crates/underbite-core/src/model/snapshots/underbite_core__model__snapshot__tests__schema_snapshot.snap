            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "p90": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "p95": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PointSeries": {
        "description": "One deterministic model's hourly forecast at the place.\n\nEvery value vector has one entry per entry of `times`; `None` is a value\nthe model did not supply.",
        "properties": {
          "gust_kmh": {
            "description": "Wind gusts at 10 m, in kilometres per hour.",

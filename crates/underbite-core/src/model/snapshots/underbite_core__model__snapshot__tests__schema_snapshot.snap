      },
      "Sample5": {
        "description": "One value at one instant.",
        "properties": {
          "quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-sample quality, overriding the series provenance (USGS qualifiers vary per value)."
          },
          "time": {
            "$ref": "#/$defs/UnixTime",
            "description": "When the value applies, UTC."
          },
          "value": {

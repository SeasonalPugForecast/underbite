---
source: crates/underbite-core/src/view/mod.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpotView",
  "description": "The conditions page of one spot.",
  "type": "object",
  "properties": {
    "cards": {
      "description": "In the user's order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Card"
      }
    },
    "header": {
      "$ref": "#/$defs/SpotHeader"
    },
    "notices": {
      "description": "Page-level messages, such as \"no data for this spot yet\".",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpotNotice"
      }
    },
    "timeline": {
      "description": "Filled when the day timeline is built.",
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineVm"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "header",
    "cards",
    "notices"
  ],
  "$defs": {
    "Agreement": {
      "description": "How closely the models agree on an event.",
      "oneOf": [
        {
          "description": "The models tell the same story.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "They differ in amounts or placement.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "They tell different stories.",
          "type": "string",
          "const": "low"
        }
      ]
    },
    "AlertOrigin": {
      "type": "string",
      "enum": [
        "marine",
        "weather"
      ]
    },
    "AlertSeverity": {
      "description": "NWS alert severity.",
      "type": "string",
      "enum": [
        "extreme",
        "severe",
        "moderate",
        "minor",
        "unknown"
      ]
    },
    "AlertVm": {
      "description": "One alert, safety text exactly as issued and never in Luna's voice.",
      "type": "object",
      "properties": {
        "ends": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": "string"
        },
        "expires": {
          "type": [
            "string",
            "null"
          ]
        },
        "headline": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "onset": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/AlertOrigin"
        },
        "severity": {
          "$ref": "#/$defs/AlertSeverity"
        },
        "severity_label": {
          "type": "string"
        },
        "zones": {
          "description": "Zone names or ids the alert covers.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "origin",
        "event",
        "severity",
        "severity_label",
        "zones"
      ]
    },
    "AlertsCard": {
      "type": "object",
      "properties": {
        "chrome": {
          "$ref": "#/$defs/CardChrome"
        },
        "compact": {
          "$ref": "#/$defs/Compact"
        },
        "full": {
          "$ref": "#/$defs/AlertsFull"
        }
      },
      "required": [
        "chrome",
        "compact",
        "full"
      ]
    },
    "AlertsFull": {
      "type": "object",
      "properties": {
        "alerts": {
          "description": "Marine and weather alerts de-duplicated, most severe first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlertVm"
          }
        }
      },
      "required": [
        "alerts"
      ]
    },
    "BandKind": {
      "type": "string",
      "enum": [
        "night",
        "slack",
        "solunar_major",
        "solunar_minor",
        "highlight"
      ]
    },
    "Card": {
      "description": "One card. Cards that a later phase adds are not variants yet.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "now"
            }
          },
          "$ref": "#/$defs/NowCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "tide"
            }
          },
          "$ref": "#/$defs/TideCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "current"
            }
          },
          "$ref": "#/$defs/CurrentCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "flow"
            }
          },
          "$ref": "#/$defs/FlowCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "water_temp"
            }
          },
          "$ref": "#/$defs/WaterTempCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "clarity"
            }
          },
          "$ref": "#/$defs/ClarityCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "waves"
            }
          },
          "$ref": "#/$defs/WavesCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "wind"
            }
          },
          "$ref": "#/$defs/WindCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "pressure"
            }
          },
          "$ref": "#/$defs/PressureCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "sun_moon"
            }
          },
          "$ref": "#/$defs/SunMoonCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "solunar"
            }
          },
          "$ref": "#/$defs/SolunarCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "marine_forecast"
            }
          },
          "$ref": "#/$defs/MarineForecastCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "storm_ahead"
            }
          },
          "$ref": "#/$defs/StormAheadCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "alerts"
            }
          },
          "$ref": "#/$defs/AlertsCard",
          "required": [
            "card"
          ]
        },
        {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "const": "sources"
            }
          },
          "$ref": "#/$defs/SourcesCard",
          "required": [
            "card"
          ]
        }
      ]
    },
    "CardChrome": {
      "description": "The frame of a card: title, provenance, credits, state, safety notices, accessibility text.",
      "type": "object",
      "properties": {
        "accessibility": {
          "description": "What `VoiceOver` reads for the card: the plain meaning first.",
          "type": "string"
        },
        "credits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CreditVm"
          }
        },
        "footnote": {
          "description": "The provenance line: \"Water 54 °F · Hudson R at Battery, NY · 0.4 mi · 6 min ago\".\nCards that combine many sources leave it empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/CardId"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        },
        "state": {
          "$ref": "#/$defs/CardState"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "credits",
        "state",
        "notices",
        "accessibility"
      ]
    },
    "CardId": {
      "description": "The cards of the dashboard, with the `snake_case` ids the configuration uses.",
      "type": "string",
      "enum": [
        "now",
        "tide",
        "current",
        "flow",
        "water_temp",
        "clarity",
        "waves",
        "wind",
        "pressure",
        "sun_moon",
        "solunar",
        "windows",
        "go_no_go",
        "storm_ahead",
        "marine_forecast",
        "stocking",
        "species",
        "alerts",
        "sources"
      ]
    },
    "CardState": {
      "description": "Whether the card's value can be trusted as current and local.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "fresh"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "Older than the user's age limit; greyed.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "stale"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "description": "From a station beyond the user's distance limit; greyed.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "far"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        }
      ]
    },
    "ChartBand": {
      "type": "object",
      "properties": {
        "end_t": {
          "type": "integer",
          "format": "int64"
        },
        "kind": {
          "$ref": "#/$defs/BandKind"
        },
        "label": {
          "type": "string"
        },
        "start_t": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "kind",
        "start_t",
        "end_t",
        "label"
      ]
    },
    "ChartMarker": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MarkerKind"
        },
        "label": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "description": "In display units, when the marker sits on the curve.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "kind",
        "t",
        "label"
      ]
    },
    "ChartPoint": {
      "description": "One point: unix seconds, the value in display units, its label (\"3.4 ft\"), and whether a\nnarrow layout should keep its label.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "major": {
          "type": "boolean"
        },
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "t",
        "value",
        "label",
        "major"
      ]
    },
    "ChartRule": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RuleKind"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "description": "In display units.",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "kind",
        "value",
        "label"
      ]
    },
    "ChartSeries": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartPoint"
          }
        },
        "role": {
          "$ref": "#/$defs/SeriesRole"
        },
        "style": {
          "$ref": "#/$defs/SeriesStyle"
        }
      },
      "required": [
        "label",
        "role",
        "style",
        "points"
      ]
    },
    "ChartTick": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "major": {
          "type": "boolean"
        },
        "t": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "t",
        "label",
        "major"
      ]
    },
    "ChartVm": {
      "description": "A chart carries every point with its label; narrow layouts thin them by `major`.",
      "type": "object",
      "properties": {
        "accessibility": {
          "description": "What `VoiceOver` reads: the shape and its extremes in words.",
          "type": "string"
        },
        "bands": {
          "description": "Shaded spans: night, slack water, solunar periods.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartBand"
          }
        },
        "markers": {
          "description": "Labelled events: highs and lows, now.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartMarker"
          }
        },
        "now_t": {
          "description": "Unix seconds of \"now\" when it falls inside the chart.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "rules": {
          "description": "Horizontal lines: flood categories, the user's ranges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartRule"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartSeries"
          }
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "description": "The y unit symbol, empty when mixed or unitless.",
          "type": "string"
        },
        "x_ticks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartTick"
          }
        }
      },
      "required": [
        "title",
        "unit",
        "x_ticks",
        "series",
        "bands",
        "rules",
        "markers",
        "accessibility"
      ]
    },
    "ClarityCard": {
      "type": "object",
      "properties": {
        "chrome": {
          "$ref": "#/$defs/CardChrome"
        },
        "compact": {
          "$ref": "#/$defs/Compact"
        },
        "full": {
          "$ref": "#/$defs/ClarityFull"
        }
      },
      "required": [
        "chrome",
        "compact",
        "full"
      ]
    },
    "ClarityFull": {
      "type": "object",
      "properties": {
        "chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartVm"
            },
            {
              "type": "null"
            }
          ]
        },
        "chlorophyll": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "kd490": {
          "$ref": "#/$defs/Kd490Vm"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "turbidity": {
          "description": "The unit symbol is the source's own: FNU, FTU or NTU, never converted.",
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kd490",
        "sections"
      ]
    },
    "Compact": {
      "description": "The compact form of a card: a headline and at most two short lines.",
      "type": "object",
      "properties": {
        "headline": {
          "$ref": "#/$defs/Quantity"
        },
        "lines": {
          "description": "At most two, not truncated or wrapped for any width.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spark": {
          "description": "A sparkline in display units, oldest first; empty when the card has none.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "required": [
        "headline",
        "lines",
        "spark"
      ]
    },
    "CreditVm": {
      "description": "The credit a source is owed.",
      "type": "object",
      "properties": {
        "licence": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The source's name as displayed.",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ]
    },
    "CurrentCard": {
      "type": "object",
      "properties": {
        "chrome": {
          "$ref": "#/$defs/CardChrome"
        },
        "compact": {
          "$ref": "#/$defs/Compact"
        },
        "full": {
          "$ref": "#/$defs/CurrentFull"
        }
      },
      "required": [
        "chrome",
        "compact",
        "full"
      ]
    },
    "CurrentEventKind": {
      "type": "string",
      "enum": [
        "max_flood",
        "max_ebb",
        "slack"
      ]
    },
    "CurrentEventVm": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CurrentEventKind"
        },
        "label": {
          "description": "\"Max flood\", \"Slack\", ...",
          "type": "string"
        },
        "speed": {
          "description": "None for slack.",
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "time",
        "kind",
        "label"
      ]
    },
    "CurrentFull": {
      "type": "object",
      "properties": {
        "bin_depth": {
          "description": "\"Bin 3 at 12 ft\": the depth the station measures at.",
          "type": [
            "string",
            "null"
          ]
        },
        "chart": {
          "description": "Speed over time with slack windows highlighted.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChartVm"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction_now": {
          "description": "Where the water is heading now, \"NNE 025°\".",
          "type": [
            "string",
            "null"
          ]
        },
        "ebb_direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurrentEventVm"
          }
        },
        "flood_direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_slack": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrentEventVm"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/CurrentPhase"
        },
        "phase_label": {
          "description": "\"Flooding\", \"Ebbing\", \"Slack\"",
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "speed_now": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "phase",
        "phase_label",
        "events",
        "sections"
      ]
    },
    "CurrentPhase": {
      "type": "string",
      "enum": [
        "flood",
        "ebb",
        "slack",
        "unknown"
      ]
    },
    "FloodCategoryVm": {
      "description": "A flood category: \"Action\", \"Minor\", \"Moderate\", \"Major\".",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "label",
        "stage"
      ]
    },
    "FlowCard": {
      "type": "object",
      "properties": {
        "chrome": {
          "$ref": "#/$defs/CardChrome"
        },
        "compact": {
          "$ref": "#/$defs/Compact"
        },
        "full": {
          "$ref": "#/$defs/FlowFull"
        }
      },
      "required": [
        "chrome",
        "compact",
        "full"
      ]
    },
    "FlowFull": {
      "type": "object",
      "properties": {
        "chart": {
          "description": "Seven days of discharge, the NWPS forecast after now, user ranges and flood stages as rules.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChartVm"
            },
            {
              "type": "null"
            }
          ]
        },
        "discharge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "flood_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FloodCategoryVm"
          }
        },
        "gage_height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "percentile": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentileVm"
            },

          "type": "integer",
          "format": "int64"
        },
        "headline": {
          "$ref": "#/$defs/StormHeadlineVm"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StormModelRowVm"
          }
        },
        "severity": {
          "$ref": "#/$defs/StormSeverity"
        },
        "start": {
          "type": "integer",
          "format": "int64"
        },
        "title": {
          "description": "\"Storm ahead · Sat night – Mon night\"",
          "type": "string"
        },
        "window": {
          "description": "When the rain or snow falls: \"Sat night – Mon night\".",
          "type": "string"
        }
      },
      "required": [
        "title",
        "window",
        "start",
        "end",
        "severity",
        "headline",
        "models"
      ]
    },
    "StormHeadlineKind": {
      "description": "What made the weather event significant.",
      "type": "string",
      "enum": [
        "snow",
        "rain",
        "gusts"
      ]
    },
    "StormHeadlineVm": {
      "description": "The figure that goes furthest past its threshold, as the most any model brings.",
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Quantity"
        },
        "kind": {
          "$ref": "#/$defs/StormHeadlineKind"
        },
        "text": {
          "description": "\"Up to 14 in of snow\", \"Up to 1.7 in of rain\" or \"Gusts to 52 mph\".",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "amount"
      ]
    },
    "StormModelRowVm": {
      "description": "One model's numbers for the event.",
      "type": "object",
      "properties": {
        "gust": {
          "$ref": "#/$defs/Quantity"
        },
        "low": {
          "description": "The lowest pressure at the spot.",
          "$ref": "#/$defs/Quantity"
        },
        "low_at": {
          "description": "\"Sun 1 PM\"",
          "type": "string"
        },
        "model": {
          "description": "The model's short name: \"ECMWF\".",
          "type": "string"
        },
        "onset": {
          "description": "When the precipitation starts: \"Sat 9 PM\".",
          "type": "string"
        },
        "precipitation": {
          "$ref": "#/$defs/Quantity"
        },
        "snow": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "model",
        "snow",
        "precipitation",
        "gust",
        "low",
        "low_at",
        "onset"
      ]
    },
    "StormSeverity": {
      "description": "How strong a coming storm is, for colouring: a model storm is a watch-level signal; a\ncyclone follows NHC's classification.",
      "type": "string",
      "enum": [
        "watch",
        "strong",
        "severe",
        "extreme"
      ]
    },
    "SunMoonCard": {
      "type": "object",
